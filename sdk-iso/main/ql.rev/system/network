#!/usr/bin/env bash
export no_proxy="localhost,127.0.0.1,::1,10.0.0.0/8,192.168.0.0/16"

configure_proxy() {
	read -p "Your HTTP proxy [IP:port]:  " PROXY
	read -p "Your Proxy Open? [y/n]: " var
	case "$var" in
		y) 
			export https_proxy="http://$PROXY"
			export http_proxy="$https_proxy"
			export ftp_proxy="$https_proxy"
			export all_proxy="$https_proxy"
			;;
		n)
			read -p "Your login:password: " var_ps
			export all_proxy="http://${var_ps}@${PROXY}"
			export https_proxy="$all_proxy"
			export http_proxy="$all_proxy"
			export ftp_proxy="$all_proxy"
			;;
		*) exit 0 ;;
	esac
}

configure_dns() {
    dns_choice=$(whiptail --title "Select a DNS server" \
    --menu "Choose your preferred DNS provider:" 15 60 5 \
    "1" "Cloudflare (1.1.1.1)" \
    "2" "Google     (8.8.8.8)" \
    "3" "Quad9      (9.9.9.9)" \
    "4" "OpenDNS    (208.67.222.222)" \
    "5" "AdguardDNS (94.140.14.14)"  \
    "6" "YandexDNS  (77.88.8.8)" 3>&1 1>&2 2>&3 )
    if [ $? -eq 0 ]; then
        case $dns_choice in
            1)
                tee -a /etc/knot-resolver/kresd.conf.dev << 'EOF'
policy.add(policy.all(policy.TLS_FORWARD({
    { '1.1.1.1', hostname = 'one.one.one.one' },
    { '1.0.0.1', hostname = 'one.one.one.one' }
})))
EOF
                ;;
            2)
                tee -a /etc/knot-resolver/kresd.conf.dev << 'EOF'
policy.add(policy.all(policy.TLS_FORWARD({
    { '8.8.8.8', hostname = 'dns.google' },
    { '8.8.4.4', hostname = 'dns.google' }
})))
EOF
                ;;
            3)
                tee -a /etc/knot-resolver/kresd.conf.dev << 'EOF'
policy.add(policy.all(policy.TLS_FORWARD({
    { '9.9.9.9', hostname = 'dns.quad9.net' },
    { '149.112.112.112', hostname = 'dns.quad9.net' }
})))
EOF
                ;;
            4)
                tee -a /etc/knot-resoler/kresd.conf.dev << 'EOF'
policy.add(policy.all(policy.TLS_FORWARD({
    { '208.67.222.222', hostname = 'resolver1.opendns.com' },
    { '208.67.220.220', hostname = 'resolver2.opendns.com' }
})))
EOF
                ;;
            5)
                tee -a /etc/knot-resolver/kresd.conf.dev << 'EOF'
policy.add(policy.all(policy.TLS_FORWARD({
    { '94.140.14.14', hostname = 'dns.adguard-dns.com' },
    { '94.140.15.15', hostname = 'dns.adguard-dns.com' }
})))
EOF
                ;;
            6)
                tee -a /etc/knot-resolver/kresd.conf.dev << 'EOF'
policy.add(policy.all(policy.TLS_FORWARD({
    { '77.88.8.8', hostname = 'common.dot.dns.yandex.net' },
    { '77.88.8.1', hostname = 'common.dot.dns.yandex.net' }
})))
EOF
        esac
        mv /etc/knot-resolver/kresd.conf.dev /etc/knot-resolver/kresd.conf
    else
        echo "Отмена выбора"
    fi

}

# Check if a Wi-Fi adapter is available

# Main Wi-Fi connection function
connect_to_wifi() {
    echo "Available Wi-Fi networks:"
    iwctl station wlan0 scan
    iwctl station wlan0 get-networks

    read -p "Enter the network SSID: " ssid
    if [ -z "$ssid" ]; then
        echo "Error: SSID cannot be empty!"
        return 1
    fi

    iwctl station wlan0 connect "$ssid"

    echo "Successfully connected to: $ssid!"

    # Offer DNS setup
    read -p "Would you like to configure DNS servers? [y/N]: " configure_dns_choice
    if [[ "$configure_dns_choice" =~ ^[Yy]$ ]]; then
        configure_dns
    fi

    return 0
}

# Check internet connectivity
check_internet() {
    echo "Checking internet connection..."
    if ping -c 3 quasarfoks.github.io &> /dev/null; then
        echo "Internet connection is active!"
        return 0
    else
        echo "No internet connection!"
        return 1
    fi
}
main() {
# Main network setup flow
    if [ "$1" = "installation" ]; then

        read -p "A Wi-Fi adapter was detected. Would you like to connect? [Y/n]: " wifi_choice
        if [[ "$wifi_choice" =~ ^[Nn]$ ]]; then
            echo "Skipping Wi-Fi setup..."
        else
            connect_to_wifi
        fi

        # Always verify internet access
        if ! check_internet; then
            echo "Warning: No internet connection detected!"
            echo "Some installation features may not work without internet access."
            read -p "Continue anyway? [y/N]: " no_internet_choice
            if [[ ! "$no_internet_choice" =~ ^[Yy]$ ]]; then
                echo "Installation aborted."
                exit 1
            fi
        fi
    else
        CHOICE=$(whiptail --title "Network Configuration" \
                        --menu "Select an item:" 15 60 5 \
            "1" "WiFi configuration" \
            "2" "DNS configuration" \
            "3" "PROXY configuration" \
            3>&1 1>&2 2>&3)

        if [ $? -eq 0 ]; then
            case "$CHOICE" in
                1) check_internet && connect_to_wifi ;;
                2) configure_dns ;;
                3) configure_proxy ;;
                *) echo "Неизвестный выбор: $CHOICE" >&2 ;;
            esac
        else
            echo "Отмена выбора"
        fi
    fi
}
main "$@"
echo "Proceeding to main installation..."
